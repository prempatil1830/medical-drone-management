# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=medical_drone_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ─── Weather API ──────────────────────────────────────────────────────────────
WEATHER_API_KEY=your_weatherapi_key_here
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
# Dev-only demo switch: set to SAFE, CAUTION, or UNSAFE to skip model and force condition
WEATHER_FORCE_CONDITION=

# ─── Map Provider ─────────────────────────────────────────────────────────────
MAP_PROVIDER_KEY=replace_with_your_map_provider_key

# ─── ML Model ─────────────────────────────────────────────────────────────────
MODEL_PATH=models/

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── LLM Explanation Service ──────────────────────────────────────────────────
# Provider options: groq, openai, anthropic (provider-agnostic)
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=5.0
